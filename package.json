{
	"name": "@yunosukeyoshino/google-apps-script-starter",
	"version": "1.1.1",
	"description": "A starter template for Google Apps Script development with React, TypeScript, Vite, Tailwind CSS, and shadcn/ui.",
	"keywords": [
		"clasp",
		"google-apps-script",
		"starter",
		"tailwindcss",
		"typescript",
		"vite"
	],
	"license": "MIT",
	"author": "YunosukeYoshino",
	"repository": {
		"type": "git",
		"url": "https://github.com/YunosukeYoshino/google-apps-script-starter.git"
	},
	"bin": {
		"create-gas-starter": "src/cli.ts"
	},
	"files": [
		"src/",
		"template/.clasp.json.example",
		"template/.claspignore",
		"template/.rules/",
		"template/AGENTS.md",
		"template/README.md",
		"template/gitignore",
		"template/package.json",
		"template/components.json",
		"template/src/",
		"template/tsconfig.json",
		"template/vite.config.ts",
		"package.json",
		"README.md",
		"tsconfig.json"
	],
	"type": "commonjs",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun run --cwd template dev",
		"build": "bun run --cwd template build",
		"push": "bun run --cwd template push",
		"deploy": "bun run --cwd template deploy",
		"deployments": "bun run --cwd template deployments",
		"open": "bun run --cwd template open",
		"lint": "oxlint .",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p template/tsconfig.json && tsc --noEmit -p sample/tsconfig.json",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt",
		"fmt:check": "oxfmt --check .",
		"test:smoke": "bun scripts/smoke-test.ts",
		"sample:build": "bun run --cwd sample build",
		"sample:typecheck": "bun run --cwd sample typecheck",
		"prepare": "husky"
	},
	"devDependencies": {
		"@google/clasp": "^3.1.3",
		"@tailwindcss/vite": "^4.1.18",
		"@types/bun": "^1.3.14",
		"@types/google-apps-script": "^2.0.8",
		"husky": "^9.1.7",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"tailwindcss": "^4.1.18",
		"typescript": "^7.0.2",
		"vite": "^8.0.14",
		"vite-plugin-singlefile": "^2.3.0",
		"vite-plugin-static-copy": "^4.1.0"
	}
}
