{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"types": ["google-apps-script"],
		"paths": {
			"@/*": ["./src/web/*"]
		}
	},
	"include": ["src"]
}
