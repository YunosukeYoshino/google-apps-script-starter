{
	"name": "my-gas-project",
	"version": "0.1.0",
	"description": "A Google Apps Script project with TypeScript, Vite, and Tailwind CSS.",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"push": "bun run build && clasp push",
		"deploy": "bun run push && clasp deploy",
		"deployments": "clasp deployments",
		"open": "clasp open-web-app",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@google/clasp": "^3.1.3",
		"@tailwindcss/vite": "^4.1.18",
		"@types/google-apps-script": "^2.0.8",
		"tailwindcss": "^4.1.18",
		"typescript": "^7.0.2",
		"vite": "^8.0.14",
		"vite-plugin-singlefile": "^2.3.0",
		"vite-plugin-static-copy": "^4.1.0"
	}
}
